{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-practice.dev/schemas/v1/finding.schema.json",
  "title": "Design Practice normalized check finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "checker",
    "rule",
    "severity",
    "policy_profile",
    "message",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "design-practice/finding/v1"
    },
    "checker": {
      "$ref": "#/$defs/id"
    },
    "rule": {
      "$ref": "#/$defs/rule"
    },
    "severity": {
      "enum": ["info", "warning", "error"]
    },
    "policy_profile": {
      "enum": ["adoption", "conforming", "production", "prototype"]
    },
    "file": {
      "$ref": "#/$defs/relativePath"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line"],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "observed_value": true,
    "suggested_correction": {
      "type": "string",
      "maxLength": 1000
    },
    "status": {
      "enum": ["fail", "not-run"]
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "rule": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "maxLength": 120
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
          }
        },
        {
          "not": {
            "pattern": "(?:^|/)\\.\\.(?:/|$)"
          }
        }
      ]
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": true
    }
  }
}
