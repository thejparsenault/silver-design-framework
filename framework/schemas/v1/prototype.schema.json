{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thejparsenault.github.io/silver-design-framework/schemas/v1/prototype.schema.json",
  "title": "Silver prototype metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "status",
    "constraint_profile",
    "revision",
    "created",
    "updated"
  ],
  "properties": {
    "schema": {
      "const": "silver/prototype/v1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "status": {
      "enum": ["draft", "active", "retained", "archived", "discarded", "promoted"]
    },
    "revision": {
      "description": "This prototype's own revision, in the same format every other artifact kind uses. Bumped in place on refinement; other artifacts cite it the same way they cite any other source.",
      "$ref": "#/$defs/revision"
    },
    "constraint_profile": {
      "enum": ["constrained", "partial", "suspended"]
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "sources": {
      "description": "Immutable historical provenance: the artifact revisions this revision was authored from. Never re-validated after this revision is written; a citation here is a permanent fact about this revision, not a live claim.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactReference"
      }
    },
    "suspended_constraints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "override_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "constraint_profile": {
            "const": "constrained"
          }
        },
        "required": ["constraint_profile"]
      },
      "then": {
        "properties": {
          "suspended_constraints": false,
          "override_reason": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "constraint_profile": {
            "const": "partial"
          }
        },
        "required": ["constraint_profile"]
      },
      "then": {
        "required": ["suspended_constraints", "override_reason"],
        "properties": {
          "suspended_constraints": {
            "minItems": 1,
            "not": {
              "contains": {
                "const": "all"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "constraint_profile": {
            "const": "suspended"
          }
        },
        "required": ["constraint_profile"]
      },
      "then": {
        "required": ["suspended_constraints", "override_reason"],
        "properties": {
          "suspended_constraints": {
            "contains": {
              "const": "all"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:r[1-9][0-9]*|sha256:[a-f0-9]{64}|[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?)$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
          }
        },
        {
          "not": {
            "pattern": "(?:^|/)\\.\\.(?:/|$)"
          }
        }
      ]
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "revision", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/revision" },
        "path": { "$ref": "#/$defs/relativePath" },
        "role": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": true
    }
  }
}
