{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thejparsenault.github.io/silver-design-framework/schemas/v1/browser-check-plan.schema.json",
  "title": "Silver browser check plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "adapter_protocol", "run_id", "provider", "adapter", "execution_mode", "connection_kind", "adapter_version", "isolation", "state_scope", "state_digest", "targets", "checkers", "plan_digest"],
  "properties": {
    "schema": { "const": "silver/browser-check-plan/v1" },
    "adapter_protocol": { "const": "silver/browser-check-adapter/v1" },
    "run_id": { "type": "string", "format": "uuid" },
    "provider": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "adapter": { "enum": ["chrome-cdp", "cli-observation", "delegated-observation", "ego-task-space"] },
    "execution_mode": { "enum": ["embedded", "cli", "delegated"] },
    "connection_kind": { "enum": ["local", "cli", "mcp", "host-native", "api", "sdk"] },
    "adapter_version": { "const": "silver/browser-check-adapter/v1" },
    "isolation": { "enum": ["temporary-profile", "provider-owned", "agent-owned"] },
    "state_scope": { "const": "workspace-check-inputs/v1" },
    "state_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target" } },
    "checkers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["accessibility", "responsive-behavior", "critical-interactions"] } },
    "plan_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "$defs": {
    "target": {
      "type": "object", "additionalProperties": false, "required": ["id", "path", "viewports"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "viewports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/viewport" } }
      }
    },
    "viewport": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }
    }
  }
}
