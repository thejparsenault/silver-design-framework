{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thejparsenault.github.io/silver-design-framework/schemas/v1/check-result.schema.json",
  "title": "Silver checker result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "checker",
    "suite",
    "policy_profile",
    "status",
    "coverage",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "silver/check-result/v1"
    },
    "checker": {
      "$ref": "#/$defs/id"
    },
    "suite": {
      "enum": ["fast", "browser", "full"]
    },
    "policy_profile": {
      "enum": ["adoption", "conforming", "production", "prototype"]
    },
    "status": {
      "enum": ["pass", "fail", "not-run", "error"]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "completed"],
      "properties": {
        "requested": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "https://thejparsenault.github.io/silver-design-framework/schemas/v1/finding.schema.json"
      }
    },
    "completed_at": {
      "description": "When this check completed. Optional only so historical unbound results remain readable; all new evidence records it.",
      "type": "string",
      "format": "date-time"
    },
    "state_scope": {
      "description": "The versioned definition of the workspace state covered by state_digest.",
      "const": "workspace-check-inputs/v1"
    },
    "state_digest": {
      "description": "Deterministic digest of the checker-visible workspace state. Optional only for historical compatibility.",
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "execution_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "message"],
      "properties": {
        "stage": { "enum": ["browser-launch", "browser-readiness", "navigation", "protocol", "inspection", "cleanup", "provider-selection", "adapter"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "target": { "type": "string", "minLength": 1 },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        "method": { "type": "string", "minLength": 1 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "attempts": { "type": "integer", "minimum": 1 },
        "process": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exit_code", "signal", "forced", "stderr"],
          "properties": {
            "exit_code": { "type": ["integer", "null"] },
            "signal": { "type": ["string", "null"] },
            "forced": { "type": "boolean" },
            "stderr": { "type": "string", "maxLength": 8000 }
          }
        }
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "fail"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "error" } },
        "required": ["status"]
      },
      "then": {
        "required": ["execution_error"],
        "properties": { "coverage": { "required": ["reason"] } }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "not-run"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "coverage": {
            "required": ["reason"]
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": true
    }
  }
}
