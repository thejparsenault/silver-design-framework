{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thejparsenault.github.io/silver-design-framework/schemas/v2/presentation-kit.schema.json",
  "title": "Silver presentation kit v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "revision",
    "updated",
    "sources",
    "roles",
    "components",
    "templates"
  ],
  "properties": {
    "schema": { "const": "silver/presentation-kit/v2" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "revision": { "$ref": "common.schema.json#/$defs/revision" },
    "updated": { "type": "string", "format": "date-time" },
    "sources": {
      "description": "Immutable historical provenance: the artifact revisions this revision was authored from. Never re-validated after this revision is written.",
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "common.schema.json#/$defs/artifactReference" }
    },
    "roles": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^--ds-[a-z0-9-]+$" },
      "required": ["canvas", "surface", "heading", "body", "muted", "accent", "border"]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "slots"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "purpose": { "type": "string", "minLength": 1 },
          "slots": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.schema.json#/$defs/id" },
            "uniqueItems": true
          }
        }
      }
    },
    "templates": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "path"],
        "properties": {
          "mode": { "enum": ["opportunity", "proposal", "outcome"] },
          "path": { "type": "string", "pattern": "^design/presentation-kit/templates/.+\\.json$" }
        }
      }
    }
  }
}
