{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thejparsenault.github.io/silver-design-framework/schemas/v2/capability-resolution.schema.json",
  "title": "Silver resolved capability and permission record v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "layers", "decisions", "providers", "degraded_capabilities"],
  "properties": {
    "schema": {
      "const": "silver/capability-resolution/v2"
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layer"],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "layer": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "action", "decision", "sources"],
        "properties": {
          "capability": {
            "$ref": "common.schema.json#/$defs/capability"
          },
          "action": {
            "$ref": "common.schema.json#/$defs/action"
          },
          "path": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "decision": {
            "enum": ["allow", "ask", "deny"]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["layer", "decision"],
              "properties": {
                "layer": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "decision": {
                  "enum": ["allow", "ask", "deny", "missing"]
                }
              }
            }
          }
        }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "status"],
        "properties": {
          "capability": {
            "$ref": "common.schema.json#/$defs/capability"
          },
          "provider": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "status": {
            "enum": ["selected", "local-fallback", "degraded", "not-run"]
          }
        }
      }
    },
    "degraded_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "coverage", "reason"],
        "properties": {
          "capability": {
            "$ref": "common.schema.json#/$defs/capability"
          },
          "coverage": {
            "enum": ["local-fallback", "degraded", "not-run"]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
