{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thejparsenault.github.io/silver-design-framework/schemas/v2/representation-binding.schema.json",
  "title": "Silver representation binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "artifact", "view", "provider", "adapter", "mapping_profile", "authority", "round_trip", "sync_policy", "last_reconciled"],
  "properties": {
    "schema": { "const": "silver/representation-binding/v1" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "artifact": { "$ref": "common.schema.json#/$defs/artifactReference" },
    "view": {
      "type": "object", "additionalProperties": false, "required": ["role", "format"],
      "properties": {
        "role": { "enum": ["local-view", "external-view"] },
        "format": { "enum": ["markdown", "mermaid", "html", "runnable-html", "figma"] },
        "path": { "$ref": "common.schema.json#/$defs/relativePath" },
        "revision": { "type": "string", "minLength": 1 }
      },
      "allOf": [{ "if": { "properties": { "role": { "const": "local-view" } } }, "then": { "required": ["path", "revision"] } }]
    },
    "provider": {
      "type": "object", "additionalProperties": false, "required": ["id", "object_id", "revision"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "object_id": { "type": "string", "minLength": 1, "maxLength": 500 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "adapter": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "version": { "$ref": "common.schema.json#/$defs/version" }
      }
    },
    "mapping_profile": { "$ref": "common.schema.json#/$defs/id" },
    "authority": { "enum": ["local", "external"] },
    "authority_provider": { "$ref": "common.schema.json#/$defs/id" },
    "round_trip": { "enum": ["lossless", "partial", "read-only", "write-only"] },
    "sync_policy": { "enum": ["notify", "manual"] },
    "last_reconciled": {
      "type": "object", "additionalProperties": false,
      "required": ["portable_revision", "portable_integrity", "external_revision", "snapshot_integrity", "at"],
      "properties": {
        "portable_revision": { "$ref": "common.schema.json#/$defs/revision" },
        "portable_integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "external_revision": { "type": "string", "minLength": 1, "maxLength": 200 },
        "snapshot_integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "snapshot_path": { "$ref": "common.schema.json#/$defs/relativePath" },
        "at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "authority": { "const": "external" } } }, "then": { "required": ["authority_provider"] } },
    { "if": { "properties": { "authority": { "const": "local" } } }, "then": { "not": { "required": ["authority_provider"] } } }
  ]
}
