{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thejparsenault.github.io/silver-design-framework/schemas/v2/provenance-bootstrap.schema.json",
  "title": "Silver legacy provenance bootstrap index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_at", "artifacts"],
  "properties": {
    "schema": { "const": "silver/provenance-bootstrap/v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "integrity", "origin", "source_revision", "source_origin"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "kind": { "type": "string", "pattern": "^(?:x-)?[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "path": { "$ref": "common.schema.json#/$defs/relativePath" },
          "integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "origin": { "const": "legacy" },
          "source_revision": { "type": "null" },
          "source_origin": { "type": "null" }
        }
      }
    }
  }
}
