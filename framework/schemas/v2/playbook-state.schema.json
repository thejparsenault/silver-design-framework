{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thejparsenault.github.io/silver-design-framework/schemas/v2/playbook-state.schema.json",
  "title": "Silver resumable playbook state v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "playbook",
    "revision",
    "status",
    "created_at",
    "updated_at",
    "inputs",
    "options",
    "current_nodes",
    "node_states",
    "checkpoints",
    "invalidations",
    "history"
  ],
  "properties": {
    "schema": {
      "const": "silver/playbook-state/v2"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "playbook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/version"
        }
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": ["running", "paused", "blocked", "complete", "stopped"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/artifactReference"
      }
    },
    "options": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    },
    "current_nodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "node_states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node", "status", "inputs", "outputs"],
        "properties": {
          "node": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "status": {
            "enum": [
              "pending",
              "ready",
              "running",
              "paused",
              "completed",
              "stale",
              "blocked",
              "skipped"
            ]
          },
          "invocation_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "inputs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/artifactReference"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/artifactReference"
            }
          }
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "node", "type", "status", "prompt"],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "node": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "type": {
            "enum": ["human", "permission", "policy", "reconciliation"]
          },
          "status": {
            "enum": ["pending", "accepted", "rejected"]
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "resolved_at": {
            "type": "string",
            "format": "date-time"
          },
          "resolution": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "invalidations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "artifact_id",
          "recorded_revision",
          "observed_revision",
          "affected_nodes",
          "detected_at",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "artifact_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "recorded_revision": {
            "$ref": "common.schema.json#/$defs/revision"
          },
          "observed_revision": {
            "oneOf": [
              { "$ref": "common.schema.json#/$defs/revision" },
              { "type": "null" }
            ]
          },
          "observed_state": {
            "enum": ["present", "missing"]
          },
          "affected_nodes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "detected_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": ["unresolved", "reconciled"]
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "event", "detail"],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "event": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
