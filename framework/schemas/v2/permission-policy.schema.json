{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thejparsenault.github.io/silver-design-framework/schemas/v2/permission-policy.schema.json",
  "title": "Silver permission policy layer v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "layer", "rules"],
  "properties": {
    "schema": {
      "const": "silver/permission-policy/v2"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "layer": {
      "enum": [
        "framework-default",
        "user-ceiling",
        "organization-restriction",
        "workspace-restriction",
        "artifact-profile",
        "skill-request",
        "invocation-constraint"
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "actions", "decision"],
        "properties": {
          "capability": {
            "$ref": "common.schema.json#/$defs/capability"
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/action"
            }
          },
          "decision": {
            "enum": ["allow", "ask", "deny"]
          },
          "paths": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/relativePath"
            }
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "provider", "available"],
        "properties": {
          "capability": {
            "$ref": "common.schema.json#/$defs/capability"
          },
          "provider": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "available": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
