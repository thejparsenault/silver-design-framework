{
  "name": "design-practice-framework",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Agent-neutral framework for design practice across codebases and tools",
  "type": "module",
  "bin": {
    "design-practice": "./bin/design-practice.mjs"
  },
  "files": [
    "bin/",
    "framework/schemas/v1/",
    "framework/skills/",
    "installer/cli.mjs",
    "installer/doctor.mjs",
    "installer/lib/",
    "installer/setup.mjs",
    "installer/templates/",
    "installer/version.mjs",
    "reference-system/"
  ],
  "scripts": {
    "validate:contracts": "python3 framework/scripts/validate_contracts.py",
    "build": "npm run validate:contracts && npm run build:reference && npm test",
    "build:reference": "node reference-system/packages/tokens/src/build.mjs",
    "test": "node --test installer/tests/*.test.mjs framework/tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "style-dictionary": "^4.3.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.0"
  }
}
