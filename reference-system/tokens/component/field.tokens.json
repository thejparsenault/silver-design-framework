{
  "field": {
    "$description": "Field and input component tokens.",
    "input": {
      "height": {
        "$type": "dimension",
        "sm": { "$value": { "value": 28, "unit": "px" }, "$description": "Compact input height" },
        "md": { "$value": { "value": 36, "unit": "px" }, "$description": "Default input height" },
        "lg": { "$value": { "value": 44, "unit": "px" }, "$description": "Large input height" }
      },
      "padding-x": {
        "$type": "dimension",
        "$value": { "value": 12, "unit": "px" },
        "$description": "Input horizontal inner padding"
      },
      "padding-y": {
        "$type": "dimension",
        "$value": { "value": 8, "unit": "px" },
        "$description": "Input vertical inner padding (for textarea)"
      },
      "font-size": {
        "$type": "dimension",
        "$value": { "value": 15, "unit": "px" },
        "$description": "Input text size"
      },
      "radius": {
        "$type": "dimension",
        "$value": { "value": 8, "unit": "px" },
        "$description": "Input border radius"
      },
      "border-width": {
        "$type": "dimension",
        "$value": { "value": 1, "unit": "px" },
        "$description": "Input border stroke"
      }
    },
    "label": {
      "font-size": {
        "$type": "dimension",
        "$value": { "value": 13, "unit": "px" },
        "$description": "Field label font size"
      },
      "font-weight": {
        "$type": "font-weight",
        "$value": 500,
        "$description": "Field label weight — medium"
      },
      "gap": {
        "$type": "dimension",
        "$value": { "value": 6, "unit": "px" },
        "$description": "Gap between label and input"
      }
    },
    "hint": {
      "font-size": {
        "$type": "dimension",
        "$value": { "value": 13, "unit": "px" },
        "$description": "Helper/hint text size"
      },
      "gap": {
        "$type": "dimension",
        "$value": { "value": 4, "unit": "px" },
        "$description": "Gap between input and hint text"
      }
    },
    "stack-gap": {
      "$type": "dimension",
      "$value": { "value": 20, "unit": "px" },
      "$description": "Vertical gap between stacked fields in a form"
    }
  }
}
