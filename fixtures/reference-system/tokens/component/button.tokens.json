{
  "button": {
    "$description": "Button component tokens. These sit above semantic tokens — consume these in button CSS, not semantic tokens directly.",
    "height": {
      "$type": "dimension",
      "sm": { "$value": { "value": 28, "unit": "px" }, "$description": "Small button min-height" },
      "md": { "$value": { "value": 36, "unit": "px" }, "$description": "Default button min-height" },
      "lg": { "$value": { "value": 44, "unit": "px" }, "$description": "Large button min-height" }
    },
    "padding-x": {
      "$type": "dimension",
      "sm": { "$value": { "value": 12, "unit": "px" }, "$description": "Small button horizontal padding" },
      "md": { "$value": { "value": 16, "unit": "px" }, "$description": "Default button horizontal padding" },
      "lg": { "$value": { "value": 20, "unit": "px" }, "$description": "Large button horizontal padding" }
    },
    "font-size": {
      "$type": "dimension",
      "sm": { "$value": { "value": 13, "unit": "px" }, "$description": "Small button label size" },
      "md": { "$value": { "value": 14, "unit": "px" }, "$description": "Default button label size" },
      "lg": { "$value": { "value": 15, "unit": "px" }, "$description": "Large button label size" }
    },
    "font-weight": {
      "$type": "font-weight",
      "$value": 500,
      "$description": "Button label weight — medium across all sizes"
    },
    "radius": {
      "$type": "dimension",
      "$value": { "value": 8, "unit": "px" },
      "$description": "Button border radius — references radius.md"
    },
    "gap": {
      "$type": "dimension",
      "$value": { "value": 6, "unit": "px" },
      "$description": "Gap between icon and label inside a button"
    },
    "border-width": {
      "$type": "dimension",
      "$value": { "value": 1, "unit": "px" },
      "$description": "Border width for secondary and ghost variants"
    }
  }
}
