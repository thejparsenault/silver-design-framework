#!/bin/sh
# Generated by The Silver Design Framework. Run `silver repair` to regenerate.
# Indirection so the workspace never hard-codes how the CLI is delivered.
# Resolution is relative to this file, so the workspace stays portable across
# machines, checkouts, users, and operating systems.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$here/../.." && pwd)
lock="$root/.silver/lock.yaml"
locked_version=$(awk '
  $1 == "framework:" { in_framework=1; next }
  in_framework && $1 == "version:" { gsub(/[\"\047]/, "", $2); print $2; exit }
  in_framework && $0 !~ /^[[:space:]]/ { exit }
' "$lock" 2>/dev/null)
if ! printf "%s" "$locked_version" | grep -Eq "^[0-9]+\.[0-9]+\.[0-9]+$"; then
  echo "Silver cannot read a stable framework.version from .silver/lock.yaml; run silver repair." >&2
  exit 78
fi
version_relation() {
  awk -v candidate="$1" -v expected="$2" 'BEGIN {
    if (candidate !~ /^[0-9]+\.[0-9]+\.[0-9]+$/) { print "invalid"; exit }
    split(candidate, c, "."); split(expected, e, ".");
    for (i=1; i<=3; i++) { if ((c[i]+0) < (e[i]+0)) { print "older"; exit }; if ((c[i]+0) > (e[i]+0)) { print "newer"; exit } }
    print "exact"
  }'
}
candidate_ok() {
  relation=$(version_relation "$1" "$locked_version")
  case "$relation" in
    exact) return 0 ;;
    newer) echo "Silver: $2 provides $1; workspace lock requests $locked_version. Continuing with the newer installation." >&2; return 0 ;;
    older) echo "Silver: skipping older $2 ($1); workspace lock requests $locked_version." >&2; return 1 ;;
    *) echo "Silver: skipping $2 because its version could not be verified." >&2; return 1 ;;
  esac
}
try_node() {
  candidate=$1; label=$2; shift 2
  [ -f "$candidate" ] || return 1
  command -v node >/dev/null 2>&1 || return 1
  observed=$(node "$candidate" version 2>/dev/null | tail -n 1)
  candidate_ok "$observed" "$label" || return 1
  export SILVER_LAUNCHER_ACTIVE=1
  exec node "$candidate" "$@"
}
try_executable() {
  candidate=$1; label=$2; shift 2
  [ -x "$candidate" ] || return 1
  observed=$("$candidate" version 2>/dev/null | tail -n 1)
  candidate_ok "$observed" "$label" || return 1
  export SILVER_LAUNCHER_ACTIVE=1
  exec "$candidate" "$@"
}
if [ -n "${SILVER_HOME:-}" ]; then
  try_executable "$SILVER_HOME/bin/silver" "SILVER_HOME" "$@"
  try_node "$SILVER_HOME/bin/silver.mjs" "SILVER_HOME" "$@"
fi
workspace_cli="$root/node_modules/silver-design-framework/bin/silver.mjs"
try_node "$workspace_cli" "workspace node_modules" "$@"
if [ "${SILVER_LAUNCHER_ACTIVE:-0}" != "1" ] && command -v silver >/dev/null 2>&1; then
  path_silver=$(command -v silver)
  case "$path_silver" in "$here/silver"|"$0") ;; *) try_executable "$path_silver" "PATH silver" "$@" ;; esac
fi
try_executable "/usr/local/lib/silver/$locked_version/bin/silver" "versioned native installation" "$@"
try_executable "/opt/homebrew/lib/silver/$locked_version/bin/silver" "versioned native installation" "$@"
# silver:fallback — the installation that generated this workspace.
try_node '/Users/jp/Projects/silver-design-framework/bin/silver.mjs' "generating installation" "$@"
# The exact published version this workspace was created with. It stays
# resolvable after npm prunes its cache, and npm verifies integrity on fetch.
if command -v npx >/dev/null 2>&1; then
  exec npx --yes silver-design-framework@"$locked_version" "$@"
fi
# Nothing left to try. A Silver workspace is a git repo — design/, .skills/,
# and .silver/ are committed, node_modules/ is not — so it is normal to clone
# one onto a machine that has neither Silver nor Node. `npx: not found` does
# not tell that person anything, so say what is missing and where to get it.
cat >&2 <<'SILVER_NOT_INSTALLED'
Silver is not installed on this machine, and this workspace needs it.

Designers - download the installer for your Mac:
  https://github.com/thejparsenault/silver-design-framework/releases/tag/v0.10.0

Developers - from this folder, with Node.js 22 or newer:
  npm install silver-design-framework@0.10.0

Either one makes the commands in this workspace work.
SILVER_NOT_INSTALLED
exit 127
