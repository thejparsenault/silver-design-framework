@echo off
setlocal EnableExtensions EnableDelayedExpansion
REM Generated by The Silver Design Framework. Run `silver repair` to regenerate.
REM Resolution is relative to this file, so the workspace stays portable.
set "root=%~dp0..\.."
set "locked_version="
for /f "tokens=2" %%V in ('findstr /R /C:"^[ ][ ]version: [0-9]" "%root%\.silver\lock.yaml" 2^>nul') do if not defined locked_version set "locked_version=%%~V"
if not defined locked_version (
  echo Silver cannot read framework.version from .silver\lock.yaml; run silver repair. 1>&2
  exit /b 78
)
if defined SILVER_HOME (
  call :try_exe "%SILVER_HOME%\bin\silver.exe" "SILVER_HOME"
  if defined selected_exe goto run_exe
  call :try_node "%SILVER_HOME%\bin\silver.mjs" "SILVER_HOME"
  if defined selected_node goto run_node
)
call :try_node "%~dp0..\..\node_modules\silver-design-framework\bin\silver.mjs" "workspace node_modules"
if defined selected_node goto run_node
if not "%SILVER_LAUNCHER_ACTIVE%"=="1" (
  set "path_silver="
  for /f "delims=" %%P in ('where silver 2^>nul') do if not defined path_silver set "path_silver=%%~fP"
  if defined path_silver if /I not "!path_silver!"=="%~f0" (
    call :try_exe "!path_silver!" "PATH silver"
    if defined selected_exe goto run_exe
  )
)
call :try_exe "%ProgramFiles%\Silver\%locked_version%\bin\silver.exe" "versioned native installation"
if defined selected_exe goto run_exe
where npx >nul 2>nul
if %ERRORLEVEL% equ 0 (
  npx --yes silver-design-framework@%locked_version% %*
  exit /b %ERRORLEVEL%
)
REM Nothing left to try — see the POSIX launcher for why this case is normal.
echo Silver is not installed on this machine, and this workspace needs it. 1>&2
echo. 1>&2
echo Designers - download the installer for your Mac: 1>&2
echo   https://github.com/thejparsenault/silver-design-framework/releases/tag/v0.10.0 1>&2
echo. 1>&2
echo Developers - from this folder, with Node.js 22 or newer: 1>&2
echo   npm install silver-design-framework@0.10.0 1>&2
echo. 1>&2
echo Either one makes the commands in this workspace work. 1>&2
exit /b 127

:try_node
if not exist "%~1" exit /b 1
set "observed="
for /f "delims=" %%V in ('node "%~1" version 2^>nul') do set "observed=%%V"
call :accept_version "!observed!" "%~2"
if "!accepted!"=="1" set "selected_node=%~1"
exit /b 0

:try_exe
if not exist "%~1" exit /b 1
set "observed="
for /f "delims=" %%V in ('"%~1" version 2^>nul') do set "observed=%%V"
call :accept_version "!observed!" "%~2"
if "!accepted!"=="1" set "selected_exe=%~1"
exit /b 0

:accept_version
set "accepted=0"
set "relation="
for /f "delims=" %%R in ('powershell -NoProfile -Command "try {$c=[version]'%~1';$e=[version]'%locked_version%';[Math]::Sign($c.CompareTo($e))} catch {'invalid'}"') do set "relation=%%R"
if "!relation!"=="0" set "accepted=1"
if "!relation!"=="1" (echo Silver: %~2 provides %~1; workspace lock requests %locked_version%. Continuing with the newer installation. 1>&2& set "accepted=1")
if "!relation!"=="-1" echo Silver: skipping older %~2 ^(%~1^); workspace lock requests %locked_version%. 1>&2
if not defined relation echo Silver: skipping %~2 because its version could not be verified. 1>&2
exit /b 0

:run_node
set "SILVER_LAUNCHER_ACTIVE=1"
node "%selected_node%" %*
exit /b %ERRORLEVEL%

:run_exe
set "SILVER_LAUNCHER_ACTIVE=1"
"%selected_exe%" %*
exit /b %ERRORLEVEL%
