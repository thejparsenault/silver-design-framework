{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thejparsenault.github.io/silver-design-framework/schemas/v2/representation-adapter.schema.json",
  "title": "Silver representation adapter v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "id", "version", "counterparts", "formats", "directions"],
  "properties": {
    "schema": { "const": "silver/representation-adapter/v1" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "counterparts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["linked-source", "provider"] } },
    "formats": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["json", "yaml", "dtcg-json", "markdown-frontmatter", "text", "binary", "figma"] } },
    "directions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["external-to-local", "local-to-external"] } }
  }
}
