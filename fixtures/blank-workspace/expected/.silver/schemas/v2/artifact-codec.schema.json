{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thejparsenault.github.io/silver-design-framework/schemas/v2/artifact-codec.schema.json",
  "title": "Silver artifact codec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "artifact_kinds", "canonical_format", "view_formats", "scripts"],
  "properties": {
    "schema": { "const": "silver/artifact-codec/v1" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "artifact_kinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/artifactKind" } },
    "canonical_format": { "enum": ["markdown-frontmatter", "json", "yaml", "dtcg-json"] },
    "view_formats": { "type": "array", "uniqueItems": true, "items": { "enum": ["markdown", "mermaid", "html", "runnable-html"] } },
    "compatibility": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "scripts": {
      "type": "object", "additionalProperties": false, "required": ["read", "write"],
      "properties": {
        "read": { "$ref": "common.schema.json#/$defs/relativePath" },
        "write": { "$ref": "common.schema.json#/$defs/relativePath" },
        "render": { "$ref": "common.schema.json#/$defs/relativePath" }
      }
    }
  }
}
