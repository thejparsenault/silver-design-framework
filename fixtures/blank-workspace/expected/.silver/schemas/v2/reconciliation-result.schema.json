{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thejparsenault.github.io/silver-design-framework/schemas/v2/reconciliation-result.schema.json",
  "title": "Silver reconciliation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "binding_id", "authority", "state", "base", "local", "external", "change_set_path", "change_set_integrity", "proposal_integrity", "status", "accepted_operations", "applied_operations", "blockers", "created_at", "updated_at"],
  "properties": {
    "schema": { "const": "silver/reconciliation-result/v1" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "binding_id": { "$ref": "common.schema.json#/$defs/id" },
    "authority": { "enum": ["local", "external"] },
    "state": { "enum": ["current", "view-stale", "external-changed", "diverged", "unmapped", "unverified", "conflict"] },
    "base": { "$ref": "#/$defs/revisionState" },
    "local": { "$ref": "#/$defs/revisionState" },
    "external": { "$ref": "#/$defs/revisionState" },
    "change_set_path": { "$ref": "common.schema.json#/$defs/relativePath" },
    "change_set_integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "proposal_integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "status": { "enum": ["notify", "awaiting-acceptance", "accepted", "applied", "blocked", "failed"] },
    "accepted_operations": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/id" } },
    "applied_operations": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/id" } },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "revisionState": {
      "type": "object", "additionalProperties": false, "required": ["revision", "integrity"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
