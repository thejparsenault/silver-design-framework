{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thejparsenault.github.io/silver-design-framework/schemas/v2/guardrail-registry.schema.json",
  "title": "Silver shared guardrail registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "guardrails"],
  "properties": {
    "schema": {
      "const": "silver/guardrail-registry/v2"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "guardrails": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "summary",
          "enforcement",
          "failure",
          "scope",
          "relaxable"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "enforcement": {
            "enum": ["deterministic-check", "agent-review", "human-review"]
          },
          "failure": {
            "type": "object",
            "additionalProperties": false,
            "required": ["behavior", "blocks"],
            "properties": {
              "behavior": {
                "enum": ["warn", "block-handoff", "stop-execution"]
              },
              "blocks": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/id"
                }
              }
            }
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["framework", "workspace", "artifact", "skill", "invocation"]
            }
          },
          "relaxable": {
            "type": "boolean"
          },
          "relaxation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allowed_profiles", "record"],
            "properties": {
              "allowed_profiles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": ["prototype-partial", "prototype-suspended"]
                }
              },
              "record": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "relaxable": {
                  "const": true
                }
              }
            },
            "then": {
              "required": ["relaxation"]
            },
            "else": {
              "not": {
                "required": ["relaxation"]
              }
            }
          }
        ]
      }
    }
  }
}
