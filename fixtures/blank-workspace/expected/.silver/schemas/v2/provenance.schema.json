{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thejparsenault.github.io/silver-design-framework/schemas/v2/provenance.schema.json",
  "title": "Silver durable provenance envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "origin", "recorded_at", "guidance", "design_contexts"],
  "properties": {
    "schema": { "const": "silver/provenance/v1" },
    "origin": { "enum": ["human-authored", "agent-assisted", "imported", "generated", "legacy"] },
    "recorded_at": { "type": "string", "format": "date-time" },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id"],
        "properties": {
          "kind": { "enum": ["human", "agent", "provider"] },
          "id": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "methods"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "revision": { "$ref": "common.schema.json#/$defs/revision" },
        "methods": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "guidance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "integrity"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "revision": { "type": "string", "minLength": 1, "maxLength": 200 },
          "integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "linked_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "integrity"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "revision": { "type": "string", "minLength": 1, "maxLength": 200 },
          "integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "design_contexts": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/artifactReference" }
    },
    "references": {
      "description": "What this work explicitly cited from a reference collection, pinned by the collection's revision at citation time. Never populated implicitly — a skill that read no references block cites none here either.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["collection", "revision", "ids"],
        "properties": {
          "collection": { "$ref": "common.schema.json#/$defs/id" },
          "revision": { "$ref": "common.schema.json#/$defs/revision" },
          "ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/id" }
          }
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "supersedes": { "$ref": "common.schema.json#/$defs/artifactReference" }
      }
    },
    "acceptance": {
      "description": "Deprecated compatibility alias. New records omit this field; skill-result.acceptance.status is authoritative.",
      "enum": ["not-required", "awaiting-review", "accepted", "rejected"]
    },
    "external_bindings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "description": "Legacy unpinned binding id; readable for compatibility but normalized to a pinned object by new invocations.",
            "$ref": "common.schema.json#/$defs/id"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "integrity"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "path": { "$ref": "common.schema.json#/$defs/relativePath" },
              "integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          }
        ]
      },
      "uniqueItems": true
    }
  }
}
