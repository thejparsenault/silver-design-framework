{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thejparsenault.github.io/silver-design-framework/schemas/v2/method-overlay.schema.json",
  "title": "Silver personal method overlay v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "revision", "applies_to", "guidance", "quality_emphasis", "exclusions", "provenance"],
  "properties": {
    "schema": { "const": "silver/method-overlay/v1" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "revision": { "$ref": "common.schema.json#/$defs/revision" },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/id" },
      "uniqueItems": true
    },
    "guidance": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "quality_emphasis": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "exclusions": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "provenance": { "$ref": "provenance.schema.json" }
  }
}
