{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thejparsenault.github.io/silver-design-framework/schemas/v2/guidance-source.schema.json",
  "title": "Silver manually linked guidance source v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "source", "influence", "scope", "linked_at", "linked_by"],
  "properties": {
    "schema": { "const": "silver/guidance-source/v1" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference", "revision", "integrity", "paths"],
      "properties": {
        "type": { "enum": ["git", "local-snapshot"] },
        "reference": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 200 },
        "integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "influence": { "enum": ["reference", "preferred", "required"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "products": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
        "surfaces": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } }
      }
    },
    "linked_at": { "type": "string", "format": "date-time" },
    "linked_by": { "type": "string", "minLength": 1, "maxLength": 160 }
  }
}
