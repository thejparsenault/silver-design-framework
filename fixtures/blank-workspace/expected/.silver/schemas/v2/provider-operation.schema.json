{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thejparsenault.github.io/silver-design-framework/schemas/v2/provider-operation.schema.json",
  "title": "Silver provider operation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "provider", "adapter", "binding_id", "operation", "direction", "capability", "permission", "status", "created_at", "payload"],
  "properties": {
    "schema": { "const": "silver/provider-operation/v1" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "provider": { "$ref": "common.schema.json#/$defs/id" },
    "adapter": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "version": { "$ref": "common.schema.json#/$defs/version" } }
    },
    "binding_id": { "$ref": "common.schema.json#/$defs/id" },
    "operation": { "enum": ["read", "normalize", "preview-write", "apply-write"] },
    "direction": { "enum": ["external-to-local", "local-to-external"] },
    "capability": { "$ref": "common.schema.json#/$defs/capability" },
    "permission": { "enum": ["allow", "ask", "deny"] },
    "approval_id": { "$ref": "common.schema.json#/$defs/id" },
    "expected_external_revision": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "enum": ["planned", "previewed", "applied", "blocked", "failed"] },
    "created_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" },
    "result_path": { "$ref": "common.schema.json#/$defs/relativePath" }
  }
}
