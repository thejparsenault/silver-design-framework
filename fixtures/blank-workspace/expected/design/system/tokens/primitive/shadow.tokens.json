{
  "shadow": {
    "$type": "shadow",
    "$description": "Elevation shadow scale. Shadow color uses neutral with alpha; do not hardcode.",
    "none": {
      "$value": {
        "color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0 },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 0, "unit": "px" },
        "blur":    { "value": 0, "unit": "px" },
        "spread":  { "value": 0, "unit": "px" }
      },
      "$description": "No shadow — flat surfaces"
    },
    "xs": {
