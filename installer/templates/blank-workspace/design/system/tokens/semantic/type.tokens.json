{
  "type": {
    "$description": "Typographic semantic roles. Before these, the entire semantic layer was colour: text.* named what a string means politically (primary, muted, danger) but nothing named what it means typographically. Type is half of any design system, and text styles are first-class objects in design tools — a vocabulary that cannot say \"this is body text\" cannot round-trip them.\n\nEach role is a composite: family, size, weight, and line height together, because that is the unit a designer actually chooses and the unit a design tool actually stores.",
    "display": {
      "$type": "typography",
      "$description": "Largest type. Marketing headers and empty-state hero text; rarely more than once per screen.",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.5xl}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.line-height.tight}",
        "letterSpacing": "{font.letter-spacing.tight}"
      }
    },
    "heading": {
      "xl": {
        "$type": "typography",
        "$description": "Page title. One per screen.",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{font.size.3xl}",
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": "{font.line-height.tight}",
          "letterSpacing": "{font.letter-spacing.tight}"
        }
      },
      "lg": {
        "$type": "typography",
        "$description": "Major section heading.",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{font.size.2xl}",
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": "{font.line-height.snug}",
          "letterSpacing": "{font.letter-spacing.normal}"
        }
      },
      "md": {
        "$type": "typography",
        "$description": "Subsection heading, card title.",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{font.size.xl}",
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": "{font.line-height.snug}",
          "letterSpacing": "{font.letter-spacing.normal}"
        }
      },
      "sm": {
        "$type": "typography",
        "$description": "Smallest heading — group labels within a section.",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{font.size.md}",
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": "{font.line-height.normal}",
          "letterSpacing": "{font.letter-spacing.normal}"
        }
      }
    },
    "body": {
      "lg": {
        "$type": "typography",
        "$description": "Lead paragraph, or body text in a reading-first layout.",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{font.size.lg}",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": "{font.line-height.relaxed}",
          "letterSpacing": "{font.letter-spacing.normal}"
        }
      },
      "md": {
        "$type": "typography",
        "$description": "Default body text. The role everything else is judged against.",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{font.size.base}",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": "{font.line-height.normal}",
          "letterSpacing": "{font.letter-spacing.normal}"
        }
      },
      "sm": {
        "$type": "typography",
        "$description": "Secondary body text — helper copy, dense tables.",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{font.size.sm}",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": "{font.line-height.normal}",
          "letterSpacing": "{font.letter-spacing.normal}"
        }
      }
    },
    "label": {
      "$type": "typography",
      "$description": "Form labels and control text. Heavier than body at the same size so it reads as interface rather than prose.",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.sm}",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": "{font.line-height.normal}",
        "letterSpacing": "{font.letter-spacing.normal}"
      }
    },
    "caption": {
      "$type": "typography",
      "$description": "Smallest supporting text — timestamps, field hints, footnotes.",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xs}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.normal}",
        "letterSpacing": "{font.letter-spacing.wide}"
      }
    },
    "code": {
      "$type": "typography",
      "$description": "Inline and block code.",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "{font.size.sm}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.relaxed}",
        "letterSpacing": "{font.letter-spacing.normal}"
      }
    }
  }
